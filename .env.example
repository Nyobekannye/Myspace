# Token dari @BotFather
BOT_TOKEN=123456:ABC-DEF

# ID Telegram admin, pisahkan dengan koma. Cek ID kamu lewat @userinfobot
ADMIN_IDS=123456789

# Nama toko yang tampil di bot
STORE_NAME=Toko Saya

# ---------- Pembayaran ----------
# qris   = QRIS otomatis via Midtrans (bot kirim QR, status lunas otomatis)
# manual = transfer + pembeli kirim foto bukti, admin konfirmasi
# Kosongkan: otomatis "qris" jika MIDTRANS_SERVER_KEY diisi, selain itu "manual"
PAYMENT_MODE=qris

# Server Key dari dashboard Midtrans (Settings → Access Keys). Pakai key sandbox dulu untuk uji coba.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
# Acquirer QRIS: gopay atau airpay shopee
MIDTRANS_ACQUIRER=gopay
# Masa berlaku QR (menit)
QRIS_EXPIRY_MINUTES=15
# Interval cek status ke Midtrans (detik). Cadangan bila webhook belum dipasang. 0 = matikan
PAYMENT_POLL_SECONDS=20

# Webhook notifikasi Midtrans (opsional, lebih cepat dari polling).
# Isi WEBHOOK_PORT lalu set Payment Notification URL di dashboard Midtrans ke
# https://domain-kamu.com/midtrans/notification
WEBHOOK_PORT=
WEBHOOK_PATH=/midtrans/notification

# Instruksi pembayaran manual (dipakai mode manual atau saat QRIS gagal dibuat)
PAYMENT_INFO=Transfer ke BCA 1234567890 a.n. Toko Saya, lalu kirim foto bukti transfer ke bot ini.

# Lokasi file data (opsional)
DATA_DIR=./data
