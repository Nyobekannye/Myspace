<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unduhan"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text" />
            <TextView
                android:id="@+id/dlCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text2" />
        </LinearLayout>
        <TextView
            android:id="@+id/dlClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bersihkan"
            android:textSize="13sp"
            android:textColor="@color/text2"
            android:padding="10dp"
            android:background="@drawable/bg_row_ripple" />
        <ImageView
            android:id="@+id/dlOpenFolder"
            style="@style/IconBtn"
            android:src="@drawable/ic_folder"
            android:contentDescription="Buka folder Download" />
    </LinearLayout>

    <TextView
        android:id="@+id/dlEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="36dp"
        android:paddingBottom="36dp"
        android:text="Belum ada unduhan\nBerkas tersimpan di folder Download"
        android:textSize="14sp"
        android:textColor="@color/text3"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/dlList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </ScrollView>
</LinearLayout>
